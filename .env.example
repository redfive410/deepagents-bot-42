# Ollama runs locally, no API key needed for `langgraph dev`. The Docker
# deployment reaches the host's Ollama via OLLAMA_HOST set directly in
# docker-compose.yml (a container's "localhost" isn't the host machine).

# LangSmith tracing/auth (required by docker-compose.yml — the self-hosted
# langgraph-api image needs a key from an account with Platform access).
# Optional for `langgraph dev`, which runs license-free.
LANGSMITH_API_KEY=

# Image built via `langgraph build`, used by docker-compose.yml
IMAGE_NAME=deepagents-bot-42
